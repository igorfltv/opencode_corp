diff --git a/packages/kilo-vscode/src/kilo-provider/corporate-command.ts b/packages/kilo-vscode/src/kilo-provider/corporate-command.ts
new file mode 100644
index 0000000..9169065
--- /dev/null
+++ b/packages/kilo-vscode/src/kilo-provider/corporate-command.ts
@@ -0,0 +1,68 @@
+import { readFile, stat } from "node:fs/promises"
+import { homedir } from "node:os"
+import { join, resolve } from "node:path"
+
+const names = new Set([
+  "login",
+  "refresh_config",
+  "skills_load",
+  "mcps_load",
+  "logout",
+  "corp_status",
+  "inference_status",
+])
+
+async function control() {
+  const dir = resolve(
+    process.env.CORP_KILO_PROFILE_DIR ??
+      process.env.CORP_PROFILE_DIR ??
+      process.env.KILO_CONFIG_DIR ??
+      join(process.env.XDG_CONFIG_HOME ?? join(homedir(), ".config"), "kilo"),
+  )
+  const file = join(dir, "corporate-state", "control.json")
+  const info = await stat(file)
+  if (info.mode & 0o077) throw new Error("Небезопасные права доступа к корпоративному control.json")
+  const control: unknown = JSON.parse(await readFile(file, "utf8"))
+  if (!control || typeof control !== "object") throw new Error("Некорректный корпоративный control.json")
+  const { port, secret } = control as { port?: unknown; secret?: unknown }
+  if (
+    !Number.isInteger(port) ||
+    Number(port) < 1 ||
+    Number(port) > 65535 ||
+    typeof secret !== "string" ||
+    !/^[A-Za-z0-9_-]{43}$/.test(secret)
+  ) {
+    throw new Error("Некорректный корпоративный control.json")
+  }
+  return { port: Number(port), secret }
+}
+
+export async function corporateAvailable(): Promise<boolean> {
+  try {
+    const state = await control()
+    const response = await fetch(`http://127.0.0.1:${state.port}/health`, {
+      headers: { Authorization: `Bearer ${state.secret}` },
+      signal: AbortSignal.timeout(2000),
+    })
+    return response.ok
+  } catch {
+    return false
+  }
+}
+
+export async function corporateCommand(name: string): Promise<{ message: string; reload: boolean }> {
+  if (!names.has(name)) throw new Error("Неизвестная корпоративная команда")
+  const state = await control()
+  const response = await fetch(`http://127.0.0.1:${state.port}/command/${name}`, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${state.secret}` },
+    signal: AbortSignal.timeout(310000),
+  })
+  const result: unknown = await response.json()
+  if (!result || typeof result !== "object") throw new Error("Некорректный ответ корпоративного плагина")
+  const data = result as { message?: unknown; reload?: unknown; error?: unknown }
+  if (!response.ok) throw new Error(typeof data.error === "string" ? data.error : "Корпоративная команда не выполнена")
+  if (typeof data.message !== "string" || typeof data.reload !== "boolean")
+    throw new Error("Некорректный ответ корпоративного плагина")
+  return { message: data.message, reload: data.reload }
+}
